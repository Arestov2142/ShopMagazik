<Window x:Class="ShopManagementApp.Windows.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары"
        Width="1250"
        Height="750"
        MinWidth="950"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary"
                         Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryHover"
                         Color="#4338CA"/>
        <SolidColorBrush x:Key="Danger"
                         Color="#DC2626"/>
        <SolidColorBrush x:Key="Warning"
                         Color="#F59E0B"/>
        <Style TargetType="TextBox">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Padding"
                    Value="14,8"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,7,0,0"/>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="MinWidth"
                    Value="130"/>
            <Setter Property="Padding"
                    Value="20,0"/>
            <Setter Property="Margin"
                    Value="0,0,12,0"/>
            <Setter Property="Background"
                    Value="{StaticResource Primary}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="{StaticResource Warning}"/>
        </Style>

        <Style x:Key="DeleteButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="{StaticResource Danger}"/>
        </Style>

        <Style x:Key="RefreshButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="#E0E7FF"/>
            <Setter Property="Foreground"
                    Value="#4338CA"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>
            <Setter Property="RowHeight"
                    Value="50"/>
            <Setter Property="ColumnHeaderHeight"
                    Value="50"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="CanUserAddRows"
                    Value="False"/>
            <Setter Property="CanUserDeleteRows"
                    Value="False"/>
            <Setter Property="CanUserReorderColumns"
                    Value="False"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>
            <Setter Property="SelectionMode"
                    Value="Single"/>
            <Setter Property="SelectionUnit"
                    Value="FullRow"/>
            <Setter Property="AutoGenerateColumns"
                    Value="False"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#F9FAFB"/>
            <Setter Property="RowBackground"
                    Value="White"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#F3F4F6"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E0E7FF"/>
                    <Setter Property="Foreground"
                            Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#111827"
                Padding="32,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Товары"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="Управление товарами магазина"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="14"
                    Padding="24"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Данные товара"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Название товара"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <TextBox x:Name="txtProductName"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Цена"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <TextBox x:Name="txtProductPrice"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Количество на складе"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <TextBox x:Name="txtProductQuantity"/>
                        </StackPanel>

                    </Grid>
                    <WrapPanel Margin="0,22,0,0">
                        <Button Content="Добавить"
                                Style="{StaticResource PrimaryButton}"
                                Click="btnAddProduct_Click"/>
                        <Button Content="Изменить"
                                Style="{StaticResource EditButton}"
                                Click="btnEditProduct_Click"/>
                        <Button Content="Удалить"
                                Style="{StaticResource DeleteButton}"
                                Click="btnDeleteProduct_Click"/>
                        <Button Content="Обновить"
                                Style="{StaticResource RefreshButton}"
                                Click="btnRefreshProducts_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    ClipToBounds="True">
                <DataGrid x:Name="dgProducts"
                          SelectionChanged="dgProducts_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding product_id}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Наименование товара"
                                            Binding="{Binding product_name}"
                                            Width="2.5*"/>
                        <DataGridTextColumn Header="Цена, руб."
                                            Binding="{Binding price, StringFormat=N2}"
                                            Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Количество на складе"
                                            Binding="{Binding quantity_in_stock}"
                                            Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>