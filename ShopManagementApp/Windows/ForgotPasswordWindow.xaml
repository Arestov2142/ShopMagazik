<Window x:Class="ShopManagementApp.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля"
        Width="480"
        Height="573"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Window.Resources>
        <!-- Поле ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Основная кнопка -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Background"
                    Value="#4F46E5"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Border Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="30">
            <StackPanel>
                <!-- Иконка -->
                <Border Width="58"
                        Height="58"
                        Background="#EEF2FF"
                        CornerRadius="14"
                        HorizontalAlignment="Left">
                    <TextBlock Text="?"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#4F46E5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <!-- Заголовок -->
                <TextBlock Text="Восстановление пароля"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,20,0,0"/>
                <TextBlock Text="Введите логин вашей учетной записи. После отправки заявки аккаунт будет временно заблокирован до смены пароля администратором."
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,7,0,25"/>
                <!-- Логин -->
                <TextBlock Text="Логин"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"/>
                <TextBox x:Name="txtLogin"
                         Margin="0,7,0,0"/>
                <!-- Ошибка -->
                <TextBlock x:Name="txtError"
                           Foreground="#DC2626"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                <!-- Отправить -->
                <Button Content="Отправить заявку"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0"
                        Click="btnSendRequest_Click"/>
                <!-- Отмена -->
                <Button Content="Отмена"
                        Height="42"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Margin="0,10,0,0"
                        Cursor="Hand"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>