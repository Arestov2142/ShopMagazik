<Window x:Class="ShopManagementApp.Windows.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Width="900"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- ============================= -->
        <!-- ПОЛЕ ВВОДА -->
        <!-- ============================= -->

        <Style TargetType="TextBox">
            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>


        <!-- ============================= -->
        <!-- ПОЛЕ ПАРОЛЯ -->
        <!-- ============================= -->

        <Style TargetType="PasswordBox">
            <Setter Property="Height"
                    Value="48"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- ============================= -->
        <!-- ОСНОВНАЯ КНОПКА -->
        <!-- ============================= -->
        <Style x:Key="LoginButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="50"/>
            <Setter Property="Background"
                    Value="#4F46E5"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================= -->
        <!-- ДОПОЛНИТЕЛЬНАЯ КНОПКА -->
        <!-- ============================= -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Background"
                    Value="#F3F4F6"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================== -->
        <!-- ЛЕВАЯ ЧАСТЬ -->
        <!-- ========================================== -->

        <Border Grid.Column="0"
                Background="#111827">

            <Grid Margin="45">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel VerticalAlignment="Center">

                    <Border Width="72"
                            Height="72"
                            Background="#4F46E5"
                            CornerRadius="18"
                            HorizontalAlignment="Left">

                        <TextBlock Text="S"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <TextBlock Text="Shop Management"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,25,0,0"/>


                    <TextBlock Text="Система управления магазином"
                               FontSize="15"
                               Foreground="#9CA3AF"
                               Margin="0,8,0,0"/>


                    <TextBlock Text="Клиенты · Товары · Заказы"
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,35,0,0"/>


                    <Border Background="#1F2937"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,35,25,0">

                        <StackPanel>

                            <TextBlock Text="Безопасный вход"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Данные пользователя проверяются в базе данных PostgreSQL."
                                       Foreground="#9CA3AF"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <TextBlock Grid.Row="1"
                           Text="Shop Management System"
                           Foreground="#6B7280"
                           FontSize="12"/>

            </Grid>

        </Border>


        <!-- ========================================== -->
        <!-- ПРАВАЯ ЧАСТЬ -->
        <!-- ========================================== -->

        <Grid Grid.Column="1">

            <Border Width="360"
                    Padding="35"
                    Background="White"
                    CornerRadius="18"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>


                    <!-- ЗАГОЛОВОК -->

                    <TextBlock Text="Авторизация"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#111827"/>


                    <TextBlock Text="Введите данные для входа в систему"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,7,0,25"/>


                    <!-- ========================================== -->
                    <!-- ЛОГИН -->
                    <!-- ========================================== -->

                    <TextBlock Text="Логин"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>


                    <TextBox x:Name="txtLogin"
                             Margin="0,7,0,18"
                             TextChanged="txtLogin_TextChanged"/>


                    <!-- ========================================== -->
                    <!-- ПАРОЛЬ -->
                    <!-- ========================================== -->

                    <TextBlock Text="Пароль"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>


                    <Grid Margin="0,7,0,0">

                        <!-- Скрытый пароль -->

                        <PasswordBox x:Name="txtPassword"
                                     PasswordChanged="txtPassword_PasswordChanged"
                                     KeyDown="txtPassword_KeyDown"/>


                        <!-- Открытый пароль -->

                        <TextBox x:Name="txtVisiblePassword"
                                 Visibility="Collapsed"
                                 TextChanged="txtVisiblePassword_TextChanged"
                                 KeyDown="txtVisiblePassword_KeyDown"/>

                    </Grid>


                    <!-- ========================================== -->
                    <!-- ПОКАЗАТЬ ПАРОЛЬ -->
                    <!-- ========================================== -->

                    <Grid Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <CheckBox x:Name="chkShowPassword"
                                  Content="Показать пароль"
                                  FontSize="12"
                                  Foreground="#6B7280"
                                  VerticalAlignment="Center"
                                  Checked="chkShowPassword_Checked"
                                  Unchecked="chkShowPassword_Unchecked"/>

                        <Button Grid.Column="2"
                                Content="Забыли пароль?"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#4F46E5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Padding="5"
                                Click="btnForgotPassword_Click"/>


                        <TextBlock x:Name="txtCapsLock"
                                   Grid.Column="1"
                                   Text="Caps Lock включён"
                                   FontSize="11"
                                   Foreground="#F59E0B"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"/>

                    </Grid>


                    <!-- ========================================== -->
                    <!-- СООБЩЕНИЕ -->
                    <!-- ========================================== -->

                    <Border x:Name="statusBorder"
                            Background="#FEF2F2"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,15,0,0"
                            Visibility="Collapsed">

                        <TextBlock x:Name="txtError"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                    </Border>


                    <!-- ========================================== -->
                    <!-- КНОПКА ВОЙТИ -->
                    <!-- ========================================== -->

                    <Button x:Name="btnLogin"
                            Content="Войти"
                            Style="{StaticResource LoginButton}"
                            Margin="0,20,0,0"
                            Click="btnLogin_Click"/>


                    <!-- ========================================== -->
                    <!-- ОЧИСТИТЬ -->
                    <!-- ========================================== -->

                    <Button x:Name="btnClear"
                            Content="Очистить поля"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0"
                            Click="btnClear_Click"/>


                    <!-- ========================================== -->
                    <!-- ИНФОРМАЦИЯ -->
                    <!-- ========================================== -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0">

                        <Ellipse x:Name="statusIndicator"
                                 Width="8"
                                 Height="8"
                                 Fill="#16A34A"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>


                        <TextBlock x:Name="txtStatus"
                                   Text="Система готова к авторизации"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>