<Window x:Class="ShopManagementApp.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора"
        Width="1450"
        Height="800"
        MinWidth="1200"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <!-- ======================================== -->
        <!-- ЦВЕТА -->
        <!-- ======================================== -->
        <SolidColorBrush x:Key="Primary"
                         Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryHover"
                         Color="#4338CA"/>
        <SolidColorBrush x:Key="Danger"
                         Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerHover"
                         Color="#B91C1C"/>
        <SolidColorBrush x:Key="Warning"
                         Color="#F59E0B"/>
        <!-- ======================================== -->
        <!-- TEXTBOX -->
        <!-- ======================================== -->
        <Style x:Key="ModernTextBox"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#4F46E5"/>
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======================================== -->
        <!-- PASSWORDBOX -->
        <!-- ======================================== -->
        <Style x:Key="ModernPasswordBox"
               TargetType="PasswordBox">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="PasswordBorder"
                                        Property="BorderBrush"
                                        Value="#4F46E5"/>
                                <Setter TargetName="PasswordBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======================================== -->
        <!-- COMBOBOX -->
        <!-- ======================================== -->

        <Style x:Key="ModernComboBox"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
        <!-- ======================================== -->
        <!-- ОСНОВНАЯ КНОПКА -->
        <!-- ======================================== -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Background"
                    Value="{StaticResource Primary}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======================================== -->
        <!-- ИЗМЕНИТЬ -->
        <!-- ======================================== -->
        <Style x:Key="EditButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="#F59E0B"/>
        </Style>
        <!-- ======================================== -->
        <!-- УДАЛИТЬ -->
        <!-- ======================================== -->
        <Style x:Key="DeleteButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="{StaticResource Danger}"/>
        </Style>
        <!-- ======================================== -->
        <!-- СВЕТЛАЯ КНОПКА -->
        <!-- ======================================== -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="#EEF2FF"/>
            <Setter Property="Foreground"
                    Value="#4338CA"/>
        </Style>
        <!-- ======================================== -->
        <!-- ВЫХОД -->
        <!-- ======================================== -->
        <Style x:Key="LogoutButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="90"/>
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Background"
                    Value="#DC2626"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LogoutBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="LogoutBorder"
                                        Property="Background"
                                        Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======================================== -->
        <!-- УВЕДОМЛЕНИЯ -->
        <!-- ======================================== -->
        <Style x:Key="NotificationButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="42"/>
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Background"
                    Value="#1F2937"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NotificationBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="NotificationBorder"
                                        Property="Background"
                                        Value="#374151"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="NotificationBorder"
                                        Property="Background"
                                        Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================================== -->
        <!-- DATAGRID -->
        <!-- ======================================== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>
            <Setter Property="RowHeight"
                    Value="54"/>
            <Setter Property="ColumnHeaderHeight"
                    Value="52"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="CanUserAddRows"
                    Value="False"/>
            <Setter Property="CanUserDeleteRows"
                    Value="False"/>
            <Setter Property="CanUserReorderColumns"
                    Value="False"/>
            <Setter Property="CanUserResizeRows"
                    Value="False"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>
            <Setter Property="SelectionMode"
                    Value="Single"/>
            <Setter Property="SelectionUnit"
                    Value="FullRow"/>
            <Setter Property="AutoGenerateColumns"
                    Value="False"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#FAFAFA"/>
            <Setter Property="RowBackground"
                    Value="White"/>
            <Setter Property="RowHeaderWidth"
                    Value="0"/>
        </Style>
        <!-- ======================================== -->
        <!-- ЗАГОЛОВОК ТАБЛИЦЫ -->
        <!-- ======================================== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#F9FAFB"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- ======================================== -->
        <!-- ЯЧЕЙКИ -->
        <!-- ======================================== -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#EEF2FF"/>
                    <Setter Property="Foreground"
                            Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

       <!-- ======================================== -->
        <!-- СТРОКИ -->
        <!-- ======================================== -->
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#F3F4F6"/>
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#EEF2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ======================================== -->
        <!-- ТЕКСТ ТАБЛИЦЫ -->
        <!-- ======================================== -->
        <Style x:Key="TableTextStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextWrapping"
                    Value="NoWrap"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
        </Style>
    </Window.Resources>


    <!-- ======================================== -->
    <!-- ОСНОВНАЯ СЕТКА -->
    <!-- ======================================== -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ======================================== -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <!-- ======================================== -->
        <Border Grid.Row="0"
                Background="#111827"
                Padding="32,0"
                CornerRadius="0,0,18,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Заголовок -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Панель администратора"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Создание и управление учетными записями"
                               FontSize="14"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>
                </StackPanel>
                <!-- Правая часть -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Заявки на пароль -->
                    <Grid Margin="0,0,14,0">
                        <Button x:Name="btnPasswordRequests"
                                Style="{StaticResource NotificationButton}"
                                ToolTip="Заявки на смену пароля"
                                Click="btnPasswordRequests_Click">
                            <Image Source="/Images/message.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"/>
                        </Button>
                        <Border x:Name="requestCountBorder"
                                Background="#DC2626"
                                MinWidth="21"
                                Height="21"
                                CornerRadius="11"
                                Padding="5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-8,-8,0">
                            <TextBlock x:Name="txtRequestCount"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Роль -->
                    <Border Background="#1F2937"
                            CornerRadius="10"
                            Padding="16,9"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="#22C55E"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Администратор"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <!-- Выход -->
                    <Button Content="Выйти"
                            Style="{StaticResource LogoutButton}"
                            Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ======================================== -->
        <!-- РАБОЧАЯ ОБЛАСТЬ -->
        <!-- ======================================== -->
        <Grid Grid.Row="1"
              Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- ======================================== -->
            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <!-- ======================================== -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="25">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Заголовок -->
                        <TextBlock Text="Данные пользователя"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Введите ФИО. Логин и корпоративная почта будут сформированы автоматически."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,25"/>
                        <!-- ======================================== -->
                        <!-- ФИО -->
                        <!-- ======================================== -->
                        <TextBlock Text="ФИО пользователя"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="txtFullName"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,7,0,18"
                                 TextChanged="txtFullName_TextChanged"/>
                        <!-- ======================================== -->
                        <!-- ЛОГИН -->
                        <!-- ======================================== -->
                        <TextBlock Text="Логин"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="txtLogin"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,7,0,18"
                                 IsReadOnly="True"
                                 Background="#F9FAFB"/>
                        <!-- ======================================== -->
                        <!-- ПОЧТА -->
                        <!-- ======================================== -->
                        <TextBlock Text="Корпоративная почта"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,7,0,18"
                                 IsReadOnly="True"
                                 Background="#F9FAFB"/>
                        <!-- ======================================== -->
                        <!-- РОЛЬ -->
                        <!-- ======================================== -->
                        <TextBlock Text="Роль"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <ComboBox x:Name="cmbRole"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,7,0,18"/>
                        <!-- ======================================== -->
                        <!-- ПАРОЛЬ -->
                        <!-- ======================================== -->
                        <TextBlock Text="Пароль / новый пароль"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <PasswordBox x:Name="txtPassword"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Margin="0,7,0,6"/>
                        <TextBlock Text="При редактировании оставьте поле пустым, если пароль менять не нужно."
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,18"/>
                        <!-- ======================================== -->
                        <!-- СОСТОЯНИЕ -->
                        <!-- ======================================== -->
                        <Border Background="#F9FAFB"
                                CornerRadius="9"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Состояние аккаунта"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"/>
                                    <TextBlock Text="Разрешить пользователю вход"
                                               FontSize="11"
                                               Foreground="#9CA3AF"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="chkActive"
                                          Grid.Column="1"
                                          IsChecked="True"
                                          Content="Активен"
                                          VerticalAlignment="Center"
                                          Foreground="#16A34A"
                                          FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                       <!-- ======================================== -->
                        <!-- КНОПКИ -->
                        <!-- ======================================== -->
                        <Grid Margin="0,25,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Content="Добавить"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="btnAddUser_Click"/>
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Content="Изменить"
                                    Style="{StaticResource EditButton}"
                                    Click="btnEditUser_Click"/>
                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Content="Изменить пароль"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="btnChangePassword_Click"/>
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    Content="Удалить"
                                    Style="{StaticResource DeleteButton}"
                                    Click="btnDeleteUser_Click"/>
                            <Button Grid.Row="4"
                                    Grid.Column="2"
                                    Content="Обновить"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="btnRefresh_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- ======================================== -->
            <!-- ПРАВАЯ ПАНЕЛЬ -->
            <!-- ======================================== -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- ======================================== -->
                    <!-- ЗАГОЛОВОК + ПОИСК -->
                    <!-- ======================================== -->
                    <Border Grid.Row="0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="22,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Пользователи"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>
                                <TextBlock Text="Выберите пользователя в таблице для редактирования."
                                           FontSize="12"
                                           Foreground="#6B7280"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Поиск -->
                            <Grid Grid.Column="1"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSearch"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="40"
                                         ToolTip="Введите фамилию"
                                         KeyDown="txtSearch_KeyDown"/>
                                <Button Grid.Column="2"
                                        Content="Поиск"
                                        Height="40"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="btnSearch_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- ======================================== -->
                    <!-- ТАБЛИЦА -->
                    <!-- ======================================== -->
                    <DataGrid x:Name="dgUsers"
                              Grid.Row="1"
                              SelectionChanged="dgUsers_SelectionChanged"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="True"
                              HorizontalContentAlignment="Stretch">
                        <DataGrid.Columns>
                            <!-- ======================================== -->
                            <!-- ЛОГИН -->
                            <!-- ======================================== -->
                            <DataGridTextColumn Header="Логин"
                                                Binding="{Binding login}"
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TableTextStyle}">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- ======================================== -->
                            <!-- ФИО -->
                            <!-- ======================================== -->
                            <DataGridTextColumn Header="ФИО пользователя"
                                                Binding="{Binding full_name}"
                                                Width="230">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TableTextStyle}">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- ======================================== -->
                            <!-- ПОЧТА -->
                            <!-- ======================================== -->
                            <DataGridTextColumn Header="Почта"
                                                Binding="{Binding email}"
                                                Width="230">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TableTextStyle}">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- ======================================== -->
                            <!-- РОЛЬ -->
                            <!-- ======================================== -->
                            <DataGridTextColumn Header="Роль"
                                                Binding="{Binding role_name}"
                                                Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TableTextStyle}">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- ======================================== -->
                            <!-- ДАТА -->
                            <!-- ======================================== -->
                            <DataGridTextColumn Header="Дата создания"
                                                Binding="{Binding created_at,
                                                StringFormat=dd.MM.yyyy HH:mm}"
                                                Width="175">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TableTextStyle}">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                        <Setter Property="HorizontalAlignment"
                                                Value="Center"/>
                                        <Setter Property="TextAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <!-- ======================================== -->
                            <!-- СТАТУС -->
                            <!-- ======================================== -->
                            <DataGridTemplateColumn Header="Статус"
                                                    Width="120">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border Padding="12,5"
                                                    CornerRadius="10"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="#FEF2F2"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#FECACA"/>
                                                        <Setter Property="BorderThickness"
                                                                Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding is_active}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#ECFDF5"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#BBF7D0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="Неактивен"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#DC2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding is_active}"
                                                                             Value="True">
                                                                    <Setter Property="Text"
                                                                            Value="Активен"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>