<Window x:Class="ShopManagementApp.Windows.PasswordRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявки на смену пароля"
        Width="900"
        Height="570"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#111827"
                Padding="30,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Заявки на смену пароля"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Обработка запросов пользователей"
                           FontSize="13"
                           Foreground="#9CA3AF"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1"
              Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="White"
                    CornerRadius="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <DataGrid x:Name="dgRequests"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логин"
                                            Binding="{Binding login}"
                                            Width="1.2*"/>
                        <DataGridTextColumn Header="ФИО"
                                            Binding="{Binding full_name}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Дата заявки"
                                            Binding="{Binding request_date,
                                            StringFormat=dd.MM.yyyy HH:mm}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding status}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="14"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Новый пароль"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <PasswordBox x:Name="txtNewPassword"
                                     Height="44"
                                     Margin="0,7,0,0"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Сменить пароль"
                            Height="44"
                            VerticalAlignment="Bottom"
                            Background="#4F46E5"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="btnChangePassword_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>