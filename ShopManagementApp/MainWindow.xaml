<Window x:Class="ShopManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop Management"
        Width="1000"
        Height="600"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- Стиль карточки-кнопки -->
        <Style x:Key="MenuButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="190"/>
            <Setter Property="Margin"
                    Value="10"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="25">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#F9FAFB"/>
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="#C7D2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="#111827"
                Padding="30,0"
                CornerRadius="0,0,18,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Shop Management"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Система управления магазином"
                           FontSize="14"
                           Foreground="#9CA3AF"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>


        <!-- Основная область -->
        <Grid Grid.Row="1"
              Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Заголовок -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Главное меню"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Выберите раздел для работы"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>
            </StackPanel>


            <!-- Карточки -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Клиенты -->

                <Button Grid.Column="0"
                        Style="{StaticResource MenuButton}"
                        Click="btnClients_Click">
                    <StackPanel>
                        <Border Width="60"
                                Height="60"
                                Background="#EEF2FF"
                                CornerRadius="14"
                                HorizontalAlignment="Left">
                            <TextBlock Text="К"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Клиенты"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Добавление, изменение и удаление клиентов."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>


                <!-- Товары -->
                <Button Grid.Column="1"
                        Style="{StaticResource MenuButton}"
                        Click="btnProducts_Click">
                    <StackPanel>
                        <Border Width="60"
                                Height="60"
                                Background="#ECFDF5"
                                CornerRadius="14"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Т"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Товары"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Управление товарами и остатками."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>


                <!-- Заказы -->
                <Button Grid.Column="2"
                        Style="{StaticResource MenuButton}"
                        Click="btnOrders_Click">
                    <StackPanel>
                        <Border Width="60"
                                Height="60"
                                Background="#FFF7ED"
                                CornerRadius="14"
                                HorizontalAlignment="Left">
                            <TextBlock Text="З"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#EA580C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Заказы"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Создание и управление заказами."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>